{
  "meta": {
    "version": "11.0",
    "description": "Airport-specific VATSIM gate/airline rules. Rules are conservative: an unknown airline is never treated as restricted unless a terminal/apron rule explicitly says so."
  },
  "airlines": {
    "EWG": {"name":"Eurowings","aliases":["EWG","EW","EUROWINGS"]},
    "DLH": {"name":"Lufthansa","aliases":["DLH","LH","LUFTHANSA"]},
    "CFG": {"name":"Condor","aliases":["CFG","DE","CONDOR"]},
    "RYR": {"name":"Ryanair","aliases":["RYR","FR","RYANAIR"]},
    "WZZ": {"name":"Wizz Air","aliases":["WZZ","W6","WIZZAIR"]},
    "EZY": {"name":"easyJet","aliases":["EZY","U2","EASYJET"]},
    "TUI": {"name":"TUI fly","aliases":["TUI","X3","TUIFLY"]},
    "AUA": {"name":"Austrian Airlines","aliases":["AUA","OS","AUSTRIAN"]},
    "SWR": {"name":"SWISS","aliases":["SWR","LX","SWISS"]},
    "KLM": {"name":"KLM","aliases":["KLM","KL"]},
    "AFR": {"name":"Air France","aliases":["AFR","AF","AIRFRANCE"]},
    "BAW": {"name":"British Airways","aliases":["BAW","BA","BRITISH AIRWAYS"]},
    "TAP": {"name":"TAP Air Portugal","aliases":["TAP","TP"]},
    "SAS": {"name":"SAS","aliases":["SAS","SK"]},
    "LOT": {"name":"LOT Polish Airlines","aliases":["LOT","LO"]},
    "FIN": {"name":"Finnair","aliases":["FIN","AY"]},
    "UAE": {"name":"Emirates","aliases":["UAE","EK"]},
    "QTR": {"name":"Qatar Airways","aliases":["QTR","QR"]},
    "SIA": {"name":"Singapore Airlines","aliases":["SIA","SQ"]},
    "THY": {"name":"Turkish Airlines","aliases":["THY","TK"]},
    "ACA": {"name":"Air Canada","aliases":["ACA","AC"]},
    "DAL": {"name":"Delta Air Lines","aliases":["DAL","DL"]},
    "UAL": {"name":"United Airlines","aliases":["UAL","UA"]},
    "AAL": {"name":"American Airlines","aliases":["AAL","AA"]},
    "ETH": {"name":"Ethiopian Airlines","aliases":["ETH","ET"]},
    "ETD": {"name":"Etihad Airways","aliases":["ETD","EY"]},
    "SVA": {"name":"Saudia","aliases":["SVA","SV"]},
    "GFA": {"name":"Gulf Air","aliases":["GFA","GF"]},
    "KAC": {"name":"Kuwait Airways","aliases":["KAC","KU"]},
    "OMA": {"name":"Oman Air","aliases":["OMA","WY"]},
    "KAL": {"name":"Korean Air","aliases":["KAL","KE"]},
    "CPA": {"name":"Cathay Pacific","aliases":["CPA","CX"]},
    "CAL": {"name":"China Airlines","aliases":["CAL","CI"]},
    "CES": {"name":"China Eastern","aliases":["CES","MU"]},
    "CSN": {"name":"China Southern","aliases":["CSN","CZ"]}
  },
  "airports": {
    "EDDF": {
      "name":"Frankfurt/Main",
      "rules":[
        {"id":"T1-A-DLH","label":"Terminal 1 A – Lufthansa only","match":"^A(?:5[0-9]|6[0-9])$","airlines":["DLH"]},
        {"id":"T1-STAR","label":"Terminal 1 A/B/C – Star Alliance / selected legacy operators","match":"^[ABCZ]","airlines":["DLH","AUA","SWR","TAP","AEE","UAL"]},
        {"id":"T2","label":"Terminal 2 / non-Star Alliance","match":"^[DE]","airlines":["CFG","EWG","RYR","WZZ","EZY","TUI","KLM","AFR","BAW","SAS","LOT","FIN","THY","ACA","DAL","AAL","ETH","ETD","SVA","GFA","KAC","OMA","KAL","CPA","CAL","CES","CSN"]},
        {"id":"T3-J","label":"Terminal 3 Pier J – designated non-Star airlines","match":"^J","airlines":["CAL","CES","CPA","CSN","ETD","GFA","KAC","KAL","OMA","QTR","SVA","TWB","UAE"]},
        {"id":"T3-H","label":"Terminal 3 Pier H – Schengen","match":"^H","airlines":[]},
        {"id":"T3-G","label":"Terminal 3 Pier G – remote/bus operations","match":"^G","airlines":[]},
        {"id":"CARGO","label":"Cargo / remote","match":"^(?:K|V)","airlines":[]}
      ],
      "deny": [
        {"match":"^[GHJK]","airlines":["CFG","EWG","RYR","WZZ","EZY","TUI","KLM","AFR","BAW","SAS","LOT","FIN","THY","ACA","DAL","AAL"]}
      ]
    },
    "EDDK": {
      "name":"Köln/Bonn",
      "rules":[
        {"id":"T1-A","label":"Terminal 1 Apron A – Lufthansa / Star Alliance","match":"^A","airlines":["DLH","AUA","SWR","TAP","LOT","SAS","FIN","THY","UAL"]},
        {"id":"T1-B","label":"Terminal 1 Apron B – passenger","match":"^B","airlines":["EWG","RYR","WZZ","EZY","TUI","DLH","CFG"]},
        {"id":"T1-C","label":"Terminal 1 Apron C – passenger","match":"^C","airlines":["EWG","RYR","WZZ","EZY","TUI","DLH","CFG"]},
        {"id":"T2-D","label":"Terminal 2 Apron D – passenger","match":"^D","airlines":["EWG","RYR","WZZ","EZY","TUI","CFG","THY","BAW","KLM","AFR","SAS","LOT","FIN","AUA","SWR"]},
        {"id":"CARGO","label":"Cargo aprons E/F/W","match":"^[EFW]","airlines":["DHL","BCS","FDX","UPS","ABR","GEC","CLX","GTI","NCR","MPH"]},
        {"id":"GA","label":"V / U – General Aviation / maintenance","match":"^[UV]","airlines":[]}
      ]
    },
    "EDDL": {
      "name":"Düsseldorf",
      "rules":[
        {"id":"A","label":"Terminal A – Lufthansa / Star Alliance","match":"^A","airlines":["DLH","AUA","SWR","TAP","LOT","SAS","FIN","THY","UAL"]},
        {"id":"B","label":"Terminal B – passenger","match":"^B","airlines":["EWG","RYR","WZZ","EZY","TUI","BAW","KLM","AFR","CFG"]},
        {"id":"C","label":"Terminal C – non-Schengen passenger","match":"^C","airlines":["EWG","RYR","WZZ","EZY","TUI","BAW","KLM","AFR","CFG","THY"]}
      ]
    },
    "EDDS": {
      "name":"Stuttgart",
      "rules":[
        {"id":"T1","label":"Terminal 1","match":"^1","airlines":["DLH","EWG","AUA","SWR"]},
        {"id":"T2","label":"Terminal 2","match":"^2","airlines":["EWG","RYR","WZZ","EZY","TUI"]},
        {"id":"T3","label":"Terminal 3","match":"^3","airlines":["EWG","RYR","WZZ","EZY","TUI"]},
        {"id":"T4","label":"Terminal 4","match":"^4","airlines":["EWG","RYR","WZZ","EZY","TUI","CFG"]}
      ]
    },
    "EDDM": {
      "name":"Munich",
      "rules":[
        {"id":"T1","label":"Terminal 1","match":"^A","airlines":["EWG","RYR","WZZ","EZY","TUI","BAW","KLM","AFR","THY","CFG"]},
        {"id":"T2","label":"Terminal 2 – Lufthansa / Star Alliance","match":"^[B-C]","airlines":["DLH","AUA","SWR","TAP","LOT","SAS","FIN","UAL","ACA"]}
      ]
    },
    "EDDB": {
      "name":"Berlin Brandenburg",
      "rules":[
        {"id":"T1","label":"Terminal 1","match":"^1","airlines":["DLH","EWG","RYR","WZZ","EZY","TUI","CFG","BAW","KLM","AFR","THY"]},
        {"id":"T2","label":"Terminal 2","match":"^2","airlines":["RYR","WZZ","EZY","EWG"]}
      ]
    },
    "EGLL": {
      "name":"London Heathrow",
      "rules":[
        {"id":"T2","label":"Terminal 2 – Star Alliance","match":"^2","airlines":["DLH","AUA","SWR","TAP","LOT","SAS","FIN","UAL","ACA","SIA"]},
        {"id":"T3","label":"Terminal 3","match":"^3","airlines":["UAE","QTR","SIA","THY","ACA","DAL","AAL"]},
        {"id":"T4","label":"Terminal 4","match":"^4","airlines":["KLM","AFR","BAW","ETD","QTR","SVA"]},
        {"id":"T5","label":"Terminal 5 – British Airways","match":"^5","airlines":["BAW"]}
      ]
    },
    "EHAM": {
      "name":"Amsterdam Schiphol",
      "rules":[
        {"id":"SCHENGEN","label":"Schengen piers","match":"^[BCDEF]","airlines":["KLM","DLH","AUA","SWR","AFR","EWG","TUI"]},
        {"id":"NON_SCHENGEN","label":"Non-Schengen piers","match":"^[GH]","airlines":["KLM","UAE","QTR","SIA","THY","BAW"]}
      ]
    },
    "LFPG": {
      "name":"Paris Charles de Gaulle",
      "rules":[
        {"id":"AF","label":"Air France / SkyTeam areas","match":"^[234]","airlines":["AFR","KLM","DAL"]},
        {"id":"OTHER","label":"Other passenger stands","match":"^[1]","airlines":["DLH","EWG","BAW","UAE","QTR","SIA","THY"]}
      ]
    }
  }
}
